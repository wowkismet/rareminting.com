{
  "expo": {
    "name": "Rare Minting",
    "slug": "rareminting",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rareminting",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0a1f14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rareminting.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rareminting.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a4a2e"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
